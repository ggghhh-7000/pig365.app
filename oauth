<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>pig365 - 系統登入</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            background-color: #f5f5f7;
        }

        .login-card {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            width: 90%;
            max-width: 360px;
            box-sizing: border-box;
        }

        h2 {
            text-align: center;
            margin-bottom: 1.5rem;
            color: #333;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        label {
            display: block;
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 0.3rem;
        }

        input {
            width: 100%;
            padding: 10px;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.2s;
        }

        input:focus {
            border-color: #007aff;
        }

        button {
            width: 100%;
            padding: 12px;
            font-size: 1rem;
            font-weight: 600;
            color: white;
            background-color: #007aff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 1rem;
            transition: background-color 0.2s;
        }

        button:hover {
            background-color: #0056b3;
        }

        button:disabled {
            background-color: #a2c8f5;
            cursor: not-allowed;
        }

        #msg {
            margin-top: 1rem;
            font-size: 0.9rem;
            text-align: center;
            min-height: 1.2em;
        }

        .error { color: #ff3b30; }
        .success { color: #34c759; }
    </style>
</head>
<body>

    <div class="login-card">
        <h2>Pig365 登入</h2>
        <div class="form-group">
            <label for="username">帳號</label>
            <input type="text" id="username" placeholder="請輸入帳號" autocomplete="off">
        </div>
        <div class="form-group">
            <label for="password">密碼</label>
            <input type="password" id="password" placeholder="請輸入密碼">
        </div>
        <button id="loginBtn" onclick="handleLogin()">登入</button>
        <div id="msg"></div>
    </div>

    <script>
        const BIN_ID = '6aa1715dac6210605ab87b62';
        const MASTER_KEY = '$2a$10$Q3e6T7l53HKgJr3pc5tuW.5dTGTAyi6948TrSpoe7mNIZm6kaRMbm';

        async function handleLogin() {
            const userIn = document.getElementById('username').value.trim();
            const passIn = document.getElementById('password').value.trim();
            const msgEl = document.getElementById('msg');
            const btn = document.getElementById('loginBtn');

            if (!userIn || !passIn) {
                msgEl.className = 'error';
                msgEl.innerText = '請填寫帳號與密碼';
                return;
            }

            msgEl.className = '';
            msgEl.innerText = '驗證中...';
            btn.disabled = true;

            try {
                const res = await fetch(`https://api.jsonbin.io/v3/b/${BIN_ID}/latest`, {
                    method: 'GET',
                    headers: {
                        'X-Master-Key': MASTER_KEY
                    }
                });

                if (!res.ok) throw new Error('無法連線至 JSONBin API');

                const data = await res.json();
                const users = data.record;

                // 比對 JSONBin 陣列中的帳號與密碼
                const match = Array.isArray(users) && users.find(u => u.username === userIn && u.password === passIn);

                if (match) {
                    msgEl.className = 'success';
                    msgEl.innerText = '登入成功！跳轉中...';
                    
                    // 登入成功後跳轉回主頁
                    setTimeout(() => {
                        window.location.href = '/';
                    }, 800);
                } else {
                    msgEl.className = 'error';
                    msgEl.innerText = '帳號或密碼錯誤';
                }
            } catch (err) {
                msgEl.className = 'error';
                msgEl.innerText = '系統驗證失敗，請檢查網路或密鑰設定';
                console.error(err);
            } finally {
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
